{% include "base.django.env.j2" %}
{# contacts backend overlay. Contacts has no S3 storage and sends no email, so the
   base emits neither block. #}
{# Key list that encrypts the stored secrets. Production requires it. #}
SALT_KEY={{ answers.SALT_KEY }}
{# Background tasks run on dramatiq. Same secret as REDIS_URL by default. #}
DRAMATIQ_BROKER_URL={{ answers.DRAMATIQ_BROKER_URL }}
DRAMATIQ_RESULT_BACKEND_URL={{ answers.DRAMATIQ_RESULT_BACKEND_URL }}
{# The frontend Caddy sets X-Forwarded-For. #}
NUM_PROXIES={{ answers.NUM_PROXIES }}
