{# contacts frontend (Caddy) runtime env. The image bundles Caddy, which serves the
   built SPA and proxies the API, CardDAV, admin, static and heartbeat paths to the
   backend. Its default backend address, localhost:8000, is wrong in a container. #}
CONTACTS_FRONTEND_BACKEND_SERVER=contacts-backend:8000
{# Proxies whose X-Forwarded-For Caddy believes. Upstream ships no default. #}
CONTACTS_FRONTEND_TRUSTED_PROXIES=private_ranges
